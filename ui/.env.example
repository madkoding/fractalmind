# Fractal-Mind UI Environment Variables

# Backend API URL
# Default port is 9000 (direct) or 12000 (Docker-mapped host port)
# Change this to point to your backend server
VITE_API_URL=http://localhost:9000

# Optional GeoIP endpoint for language auto-detection
# Must return JSON with country code (for example: country_code or countryCode)
VITE_GEOIP_URL=https://ipapi.co/json/
